{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "build-debug",
      "name": "Launch",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_server",
      "args": [
        "${input:sendBufferSize}",
        "${input:recvBufferSize}"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set debuginfod enabled off" }
      ]
    },
    {
      "preLaunchTask": "build-debug",
      "name": "Launch Tests",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_tests",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_break_on_failure"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true},
        { "text": "set debuginfod enabled off" }
      ]
    },
    {
      "preLaunchTask": "build-debug",
      "name": "ejd_bot (echo)",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_bot",
      "args": ["echo", "${input:botCount}"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set debuginfod enabled off" }
      ]
    },
    {
      "preLaunchTask": "build-debug",
      "name": "ejd_bot (drain)",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_bot",
      "args": ["drain"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set debuginfod enabled off" }
      ]
    },
    {
      "preLaunchTask": "build-debug",
      "name": "ejd_bot (bomb)",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_bot",
      "args": ["bomb", "${input:botCount}"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set debuginfod enabled off" }
      ]
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "gtest filter (ex: SmokeTest.* or * )",
      "default": "*"
    },
    {
      "id": "botCount",
      "type": "promptString",
      "description": "echo/bomb: 커넥션 수",
      "default": "10"
    },
    {
      "id": "sendBufferSize",
      "type": "promptString",
      "description": "커널 송신버퍼 크기 (기본: 0 권장, drain/bomb test: 4096)",
      "default": "0"
    },
    {
      "id": "recvBufferSize",
      "type": "promptString",
      "description": "커널 수신버퍼 크기 (기본: 0 권장, drain/bomb test: 4096)",
      "default": "0"
    }
  ]
}
