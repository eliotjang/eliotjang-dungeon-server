{
  "version": "0.2.0",
  "configurations": [
    {
      "preLaunchTask": "build-debug",
      "name": "Launch",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceFolder}/build/debug/ejd_server",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": true,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "set debuginfod enabled off" }
      ]
    },
    {
      "preLaunchTask": "build-debug",
      "name": "Launch Tests",
      "request": "launch",
      "type": "cppdbg",
      "program": "${workspaceRoot}/build/debug/ejd_tests",
      "args": [
        "--gtest_filter=${input:gtestFilter}",
        "--gtest_break_on_failure"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true},
        { "text": "set debuginfo enabled off" }
      ]
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "gtest filter (ex: SmokeTest.* or * )",
      "default": "*"
    }
  ]
}
